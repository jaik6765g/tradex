# ============================================================
# TradeX Backend — local development environment
# Copy to backend/.env and fill in secrets locally.
# ============================================================

# ------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# DATABASE (local PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://tradex_admin@localhost:5432/tradex
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=tradex_admin
DATABASE_PASSWORD=
DATABASE_NAME=tradex
DATABASE_SSL=false
# Set DATABASE_LOGGING=true only when you need raw SQL query logs.
DATABASE_LOGGING=false

# ------------------------------------------------------------
# REDIS (local — BullMQ queues)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# SUPABASE (external identity provider — BACKEND ONLY, never frontend)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------
# BSC MAINNET
# ------------------------------------------------------------
BSC_RPC_URL=
BSC_RPC_URL_FALLBACK=
BSC_CHAIN_ID=56
BSC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BSC_USDT_DECIMALS=18
BSC_REQUIRED_CONFIRMATIONS=15
BSC_SCAN_INTERVAL=60000
BSC_MAX_BLOCKS_PER_SCAN=50
MIN_USDT_DEPOSIT=
TDX_PER_USDT=100

# ------------------------------------------------------------
# TRADEX (contracts / treasury)
# ------------------------------------------------------------
TRADEX_VAULT_ADDRESS=
TRADEX_WITHDRAWAL_VAULT_ADDRESS=
TRADEX_DELEGATION_MANAGER_ADDRESS=
TREASURY_ADDRESS=
ADMIN_PRIVATE_KEY=

# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------
# Legacy admin-wallet identification (optional after mobile-auth migration).
ADMIN_WALLET=

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# OPTIONAL FEATURE TUNING (defaults are safe; only override when needed)
# ------------------------------------------------------------
# PULSE_BINANCE_PRICE_URL=
# PULSE_PRICE_AGGREGATION_METHOD=
# PULSE_EXPIRY_SETTLEMENT_ENABLED=
# LOTTO_ROUND_ENGINE_ENABLED=
# WITHDRAWAL_REQUIRED_CONFIRMATIONS=
# LOTTO_RESULT_MODE (SERVER_RANDOM | ADMIN_RESULT | VERIFIED_RANDOM)

# ------------------------------------------------------------
# WINGO 30-SECOND PERIOD SYNC (authoritative TPPLAY reference)
# ------------------------------------------------------------
# When enabled, the THIRTY_SEC lotto category sources its period number and
# timing exclusively from the external reference — never generated locally.
WINGO_SYNC_ENABLED=true
WINGO_SYNC_URL=https://draw.ar-lottery01.com/WinGo/WinGo_30S.json
# WinGo 1M / 3M / 5M use the SAME sync mechanism, each with its own reference.
WINGO_SYNC_URL_1M=https://draw.ar-lottery01.com/WinGo/WinGo_1M.json
WINGO_SYNC_URL_3M=https://draw.ar-lottery01.com/WinGo/WinGo_3M.json
WINGO_SYNC_URL_5M=https://draw.ar-lottery01.com/WinGo/WinGo_5M.json
WINGO_SYNC_TIMEOUT_MS=5000


# ------------------------------------------------------------
# DEPOSIT GATEWAY (custody / sweep)
# ------------------------------------------------------------
# Address provider: dev | self_custody | custody
#   dev           = deterministic DEV addresses (NO private key — local only)
#   self_custody  = BIP44 HD wallet derived from DEPOSIT_WALLET_MNEMONIC
#   custody       = institutional custody (future — provide a provider impl)
# In production, `dev` is REJECTED (startup fails).
DEPOSIT_ADDRESS_PROVIDER=dev

# Self-custody HD wallet mnemonic (NEVER commit; NEVER expose to frontend).
# Only required when DEPOSIT_ADDRESS_PROVIDER=self_custody.
# DEPOSIT_WALLET_MNEMONIC=

# Sweep received funds to treasury. Off by default (safe).
DEPOSIT_SWEEP_ENABLED=false
DEPOSIT_TREASURY_ADDRESS=
DEPOSIT_SWEEP_GAS_LIMIT=100000

# ------------------------------------------------------------
# ADMIN BSC GAS WALLET (dedicated server-side BNB funding wallet)
# ------------------------------------------------------------
# Funds ONLY the manual admin BNB top-up flow (Admin → BSC Gas & Sweep).
# MUST be a different key from the custody master seed (DEPOSIT_WALLET_MNEMONIC).
# Private key stays server-side (env/secret-manager only) — never DB/frontend/logs.
# BSC_GAS_WALLET_PRIVATE_KEY=
# Safety buffer added on top of gasLimit*gasPrice when computing required gas.
BSC_GAS_SAFETY_BUFFER_BNB=0.0005

# Deposit order expiry (minutes)
DEPOSIT_ORDER_EXPIRY_MINUTES=30

# ------------------------------------------------------------
# MULTI-NETWORK EVM USDT (BSC is the only network enabled by default)
# ------------------------------------------------------------
# All public network facts live in src/deposit-gateway/config/networks.config.ts.
# Enable another EVM network by setting its RPC + (optionally) enabling it.
# Env prefix is the UPPERCASE network id (consistent with BSC_RPC_URL):
#   ETHEREUM_RPC_URL=...   ETHEREUM_USDT_ADDRESS=0xdAC17F...  ETHEREUM_DEPOSIT_ENABLED=true
#   POLYGON_RPC_URL=...    ARBITRUM_RPC_URL=...    OPTIMISM_RPC_URL=...
#   AVALANCHE_RPC_URL=...  BASE_RPC_URL=...        (Base also needs BASE_USDT_ADDRESS)
# Per-network overrides: <ID>_USDT_DECIMALS, <ID>_REQUIRED_CONFIRMATIONS, <ID>_EXPLORER.
# Per-network treasury: <ID>_TREASURY_ADDRESS (falls back to DEPOSIT_TREASURY_ADDRESS).

# ------------------------------------------------------------
# TRON (TRC-20 USDT) — DISABLED by default
# ------------------------------------------------------------
# Requires: TRON_RPC_URL + TRON_DEPOSIT_ENABLED=true (+ a real custody mnemonic).
#   TRON_RPC_URL=https://api.trongrid.io
#   TRON_DEPOSIT_ENABLED=true
#   TRON_DEPOSIT_WALLET_MNEMONIC=...   # TRON custody mnemonic (falls back to DEPOSIT_WALLET_MNEMONIC)
#   TRON_TREASURY_ADDRESS=...          # TRON treasury (falls back to DEPOSIT_TREASURY_ADDRESS)
#   TRON_GRID_API_KEY=...              # optional TronGrid TRON-PRO-API-KEY (never logged)
#   TRON_SWEEP_GAS_TRX=20              # required/fee TRX for a TRC-20 sweep (gas only)
#   TRON_RECONCILIATION_INTERVAL_MINUTES=15
# TRON address derivation is real Base58Check (SLIP-44 coin type 195 → chainId 195).

# ------------------------------------------------------------
# SOLANA (SPL USDT) — DISABLED by default (opt-in)
# ------------------------------------------------------------
# Full pipeline: address derivation (Ed25519 / SLIP-0010 / m/44'/501'/0'/0'/<index>',
# chainId 501), detection, confirmation, TDX credit, SPL sweep (durable nonce),
# full-balance reconciliation, and production preflight are ALL implemented.
# Enable by setting the RPC + required flags:
#   SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#   SOLANA_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
#   SOLANA_USDT_DECIMALS=6
#   SOLANA_REQUIRED_CONFIRMATIONS=32
#   SOLANA_EXPLORER_URL=https://solscan.io
#   SOLANA_DEPOSIT_WALLET_MNEMONIC=...
#   SOLANA_WATCHER_ENABLED=true
#   SOLANA_DEPOSIT_ENABLED=true
#   SOLANA_SWEEP_ENABLED=true
#   SOLANA_TREASURY_ADDRESS=<valid Solana treasury address>
#   SOLANA_SWEEP_GAS_LAMPORTS=5000
#   SOLANA_RECONCILIATION_INTERVAL_MINUTES=15
# IMPORTANT: sweep requires a pre-funded durable nonce PDA per deposit address.
