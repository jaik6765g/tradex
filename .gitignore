# =============================================================
# TradeX — root .gitignore
# =============================================================

# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
.nyc_output/

# Environment files (secrets — NEVER commit)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
dump.rdb
*.rdb
*.pid
*.pid.lock

# OS
.DS_Store

# IDE / editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.tsbuildinfo

# Evidence / artifacts (local test outputs)
.artifacts/
backend/.artifacts/tradex-telegram-bot/
